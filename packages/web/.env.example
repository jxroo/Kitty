# Optional. The public devnet RPC rate-limits (HTTP 429) under load; for a live demo use a
# dedicated devnet endpoint, e.g. https://devnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Optional. The SPL mint kasas are created with (defaults to the public test złoty, tPLN).
# NEXT_PUBLIC_MINT=3m9ZBm3NqJSRbMdCbnsB5fZWKxpk6tFWeU6PGhzcM8HG

# Server only. JSON array of the faucet keypair (mint authority of tPLN). Never commit it.
# FAUCET_SECRET_KEY=[1,2,3,...]

# Optional. Used for "where in the code" links.
NEXT_PUBLIC_REPO_URL=https://github.com/jxroo/kasa-bez-zarzadu

# Bot only (scripts/crank.ts). Any devnet keypair with a little SOL: it pays fees and has no
# rights in the program. JSON array, or a path in CRANK_KEYPAIR. Never commit it.
# CRANK_SECRET_KEY=[1,2,3,...]
# CRANK_KEYPAIR=~/crank-keypair.json
